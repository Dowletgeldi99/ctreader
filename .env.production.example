NODE_ENV=production
DOMAIN=bot.example.com
UI_DOMAIN=example.com
UI_DIST_PATH=/opt/ui/dist
ACME_EMAIL=admin@example.com

# Generate independently: openssl rand -hex 32
POSTGRES_PASSWORD=replace_with_random_database_password
REDIS_PASSWORD=replace_with_random_redis_password
ADMIN_API_KEY=replace_with_at_least_32_random_characters
AGENT_TOKEN_PEPPER=replace_with_a_different_random_secret

TELEGRAM_BOT_TOKEN=replace_with_botfather_token
# Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=replace_with_random_webhook_secret
TELEGRAM_MODE=webhook

# Keep false during demo certification.
ALLOW_REAL_TRADING=false
TRADING_KILL_SWITCH=false
MAX_RISK_PERCENT=0.50
MAX_DAILY_LOSS_PERCENT=1.00
MAX_FIXED_LOT=1.00
MAX_OPEN_POSITIONS_PER_USER=10
CTRADER_MARGIN_BUFFER_PERCENT=25
CTRADER_JOB_LEASE_SECONDS=45
PAIRING_CODE_TTL_SECONDS=600
# Optional external Store/invite URL. Leave empty to download the auto-built .algo from this backend.
CBOT_INSTALL_URL=
SUBSCRIPTIONS_ENFORCED=true
TELEGRAM_ADMIN_IDS=replace-with-your-telegram-id

CTRADER_ENABLED=true
CTRADER_MOCK_MODE=false
CTRADER_CLIENT_ID=replace_with_ctrader_client_id
CTRADER_CLIENT_SECRET=replace_with_ctrader_client_secret
# Generate: openssl rand -base64 32
CTRADER_TOKEN_ENCRYPTION_KEY=replace_with_base64_32_byte_key

# Supplied by docker-compose.production.yml; do not use localhost in containers.
DATABASE_URL=postgresql://placeholder
REDIS_URL=redis://placeholder
PUBLIC_BASE_URL=https://bot.example.com
CTRADER_REDIRECT_URI=https://bot.example.com/api/v1/ctrader/oauth/callback
