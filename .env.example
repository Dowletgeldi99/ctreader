NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://newsbot:newsbot@localhost:5432/newsbot?schema=public
REDIS_URL=redis://localhost:6379
PUBLIC_BASE_URL=https://bot.example.com

# Leave empty to run the API without Telegram during local development.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret
TELEGRAM_MODE=disabled

# Protects internal/operator-only endpoints. Use at least 32 random characters.
ADMIN_API_KEY=replace-with-a-random-admin-key
AGENT_TOKEN_PEPPER=replace-with-a-different-random-pepper

# System hard limits. User settings can only be stricter.
ALLOW_REAL_TRADING=false
# Emergency stop. When true, no new MT5 or cTrader job can be created or submitted.
TRADING_KILL_SWITCH=false
MAX_RISK_PERCENT=0.50
MAX_DAILY_LOSS_PERCENT=1.00
MAX_FIXED_LOT=1.00
MAX_OPEN_POSITIONS_PER_USER=10
# New cTrader margin must fit with this additional safety reserve.
CTRADER_MARGIN_BUFFER_PERCENT=25
# Distributed worker lease; another backend may recover a job after this timeout.
CTRADER_JOB_LEASE_SECONDS=45
PAIRING_CODE_TTL_SECONDS=600
# Optional. Defaults to PUBLIC_BASE_URL/api/v1/cbot/download.
CBOT_INSTALL_URL=

# Subscription rollout. Keep false while migrating existing users, then enable in production.
SUBSCRIPTIONS_ENFORCED=false
# Comma-separated Telegram numeric IDs allowed to use /admin_activate and /admin_suspend.
TELEGRAM_ADMIN_IDS=

# cTrader Open API. Register an application at openapi.ctrader.com first.
CTRADER_ENABLED=false
CTRADER_MOCK_MODE=false
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=https://bot.example.com/api/v1/ctrader/oauth/callback
# Generate once: openssl rand -base64 32
CTRADER_TOKEN_ENCRYPTION_KEY=
